---
import { Image } from "astro:assets";
import { navItems } from "@/lib/navigation";
import Container from "./container.astro";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href);
}
---

<header
  class="site-header py-2 sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60 [container-type:scroll-state] [container-name:site-header]"
>
  <Container class="header-content h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold text-lg" data-astro-prefetch>
      <Image
        src="/images/astro-logo.png"
        alt="My Astro Site Logo"
        width={48}
        height={48}
        class="w-12 h-12 aspect-square object-cover"
      />
      <span>Blog</span>
    </a>

    <nav class="hidden md:flex items-center gap-2 min-w-fit">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          data-astro-prefetch
          class:list={[
            "text-sm font-medium px-4 py-2 transition-colors rounded-full",
            isActive(item.href) 
              ? "text-foreground bg-muted font-semibold" 
              : "text-foreground/80 hover:text-foreground hover:bg-muted/50",
            { "relative [anchor-name:--nav]": index === 0 },
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </Container>
</header>
